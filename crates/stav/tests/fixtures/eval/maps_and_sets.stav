#! render json toml yaml
type Level = debug | info | warn
struct Root {
  limits:  Map<Level, Int> = {}
  levels:  Set<Level> = []
  sysctl:  Map<Str, Data> = {}
  env:     Map<Str, Str> = {}
  kernel:  Kernel = {}
}
struct Kernel { modules: List<Str> = [], params: Map<Str, Str> = {} }
limits = { warn = 3, debug = 1 }
limits.info = 2
levels = [warn, debug]
levels = [info, warn]
sysctl."vm.swappiness" = 10
sysctl { "net.ipv4.ip_forward" = 1 }
env { RUST_LOG = "info", "WITH SPACE" = "yes" }
kernel = { modules = ["kvm-amd"] }
kernel.modules = ["vfio-pci"]
kernel { params { quiet = "" } }
