#! render json toml yaml
type Level = debug | info | warn
struct Root {
  limits:  Map<Level, Int> = {}
  levels:  Set<Level> = []
  tunables:  Map<Str, Data> = {}
  env:     Map<Str, Str> = {}
  kernel:  Kernel = {}
}
struct Kernel { modules: List<Str> = [], params: Map<Str, Str> = {} }
limits = { warn = 3, debug = 1 }
limits.info = 2
levels = [warn, debug]
levels = [info, warn]
tunables."mem.reclaim" = 10
tunables { "net.forwarding" = 1 }
env { LOG_LEVEL = "info", "WITH SPACE" = "yes" }
kernel = { modules = ["virt-host"] }
kernel.modules = ["pci-passthru"]
kernel { params { quiet = "" } }
