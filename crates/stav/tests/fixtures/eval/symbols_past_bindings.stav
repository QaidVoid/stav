#! symbol Pkg pkg words
#- file main.stav
import "./lib.stav" as fetcher
struct Unit { after: List<Ref<Unit>> = [] }
struct Root {
  packages: List<Pkg> = []
  primary:  Option<Pkg>
  units:    Map<Str, Unit> = {} block unit
}

fn bus() -> Part<Root> = part { packages = [bus] }
fn tools(tool: Str) -> Part<Root> = part { packages = [tool] }
fn wrapped(shell: Pkg) -> Part<Root> = part { packages = [shell] }
let prompt: Pkg = pkg("Prompt")
let cache: Ref<Unit> = "db"

include bus()
include tools("ignored")
include wrapped(console)
packages = [prompt, fetcher]
for editor in [1] {
  packages = [editor]
}
primary = bus
unit db {}
unit web { after = [bus, cache] }
unit bus {}
#- file lib.stav
let version = 8
