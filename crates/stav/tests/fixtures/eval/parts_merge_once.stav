#- file main.stav
struct Service { exec: List<Str> = [], after: List<Str> = [] }
struct Root {
  packages: List<Str> = []
  services: Map<Str, Service> = {} block service
  ports:    List<Int> = []
}

fn bus() -> Part<Root> = part { packages = ["bus"] }
fn audio() -> Part<Root> = part {
  include bus()
  packages = ["mixer"]
}
fn bluetooth() -> Part<Root> = part {
  include bus()
  include "./firmware.stav"
  packages = ["radio"]
}
fn remote(port: Int = 22) -> Part<Root> = part { ports = [port] }
fn wrap(p: Part<Root>) -> Part<Root> = part { include p }
fn unit(name: Str) -> Part<Service> = part { after = [name] }
fn ported(f: Fn(Int) -> Int) -> Part<Root> = part { ports = [f(4000)] }
fn offset(by: Int) -> Fn(Int) -> Int = fn(x: Int) = x + by
let shared: Part<Root> = part { packages = ["shared"] }

include audio()
include bluetooth()
include bus()
include "./firmware.stav"
include remote()
include remote(port = 22)
include remote(port = 2222)
include wrap(remote(port = 2222))
include wrap(remote(port = 8022))
include ported(offset(1))
include ported(offset(1))
include ported(offset(2))
include shared
include shared
for i in [1, 2] {
  include shared
}
service a {
  include unit("network")
  include unit("network")
  include unit("bus")
}
service b { include unit("network") }
#- file firmware.stav
packages = ["firmware"]
