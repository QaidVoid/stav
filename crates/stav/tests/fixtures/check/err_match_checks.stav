type Mode = on | off(after: Int)
type Wide = wide(f0: Bool, f1: Bool, f2: Bool, f3: Bool, f4: Bool, f5: Bool, f6: Bool, f7: Bool, f8: Bool, f9: Bool, f10: Bool, f11: Bool, f12: Bool, f13: Bool, f14: Bool, f15: Bool, f16: Bool, f17: Bool, f18: Bool, f19: Bool, f20: Bool, f21: Bool, f22: Bool, f23: Bool)
struct Root { a: Int = 0 }

fn no_payload(m: Mode) -> Int = match m {
  on(after = 1) => 1
  _ => 0
}

fn unreachable_and_missing(m: Mode) -> Int = match m {
  on => 1
  on => 2
}

fn too_complex(w: Wide) -> Int = match w {
  wide(f0 = true | false, f1 = true | false, f2 = true | false, f3 = true | false, f4 = true | false, f5 = true | false, f6 = true | false, f7 = true | false, f8 = true | false, f9 = true | false, f10 = true | false, f11 = true | false, f12 = true | false, f13 = true | false, f14 = true | false, f15 = true | false, f16 = true | false, f17 = true | false, f18 = true | false, f19 = true | false, f20 = true | false, f21 = true | false, f22 = true | false, f23 = true | false) => 1
}
