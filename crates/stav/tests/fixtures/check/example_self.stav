#! entries main.stav overlay.stav
#- file main.stav
struct Source {
  url:    Str
  sha256: Str
}

struct Tool {
  version: Str
  source:  Source
}

struct Root { tools: Map<Str, Tool> = {} block tool }

tool jq {
  version = "1.7.1"
  source {
    url    = "https://github.com/jqlang/jq/releases/download/jq-#{self.version}/jq-#{self.version}.tar.gz"
    sha256 = "478c9ca129fd2e3443fe27314b455e211e0d8c60bc8ff7df703873deeee580c2"
  }
}
#- file overlay.stav
tool jq {
  version = force("1.8.0")
  source { sha256 = force("2be64e7129cecb11d5906290eba10af694fb9e3e7f9fc208a311dc33ca837eb0") }
}
