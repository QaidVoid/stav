#! root Root
system {
  hostname = "forge"
  service gateway { exec = ["/usr/bin/gateway", "-D"] }
}
#- prelude system.stav
## A long-running program.
struct Service {
  ## The command line.
  exec: List<Str> where nonEmpty
  enable: Bool = true
}

struct System {
  hostname: Str where hostname
  services: Map<Str, Service> = {} block service
}

struct Root { system: System }

fn hostname(s: Str) -> Bool = len(s) > 0 && len(s) < 64
#- part base.stav
system {
  hostname = default("localhost")
  service console { exec = default(["/sbin/console"]) }
}
