import "std/build" as build
import "ns/target" as target

## A fast compression library and tool.
package squash {
  version = "1.5.6"
  summary = "Squash compression library and tools"
  license = [BSD-3-Clause, GPL-2.0-only]

  source main {
    url    = "https://example.org/squash/releases/v#{self.version}/squash-#{self.version}.tar.gz"
    sha256 = "sha256:8c29e06cf42aacc1eafc4077ae2ec6c6fcb96a626157e0593d5e82a34fd403c1"
  }

  patches = [./patches/0001-no-werror.patch]

  build_deps = [builder, runner, pkgtool]
  link_deps  = [codec, packer, quickpack]

  build configured {
    options = match target.variant {
      dynamic => ["-Ddefault_library=shared"]
      static  => ["-Ddefault_library=static", "-Dbin_programs=true"]
    }
  }

  phases {
    subdir       = "build/out"
    post_install = """
      install -Dm644 ../../LICENSE "$DESTDIR/usr/share/licenses/squash/LICENSE"
      rm -f "$DESTDIR"/usr/bin/squash-small
      """
  }

  subpackage libs {
    summary = "Squash shared library"
    files   = ["usr/lib/libsquash.so.*"]
  }

  smoke = "squash --version | grep -q #{self.version}"
}
