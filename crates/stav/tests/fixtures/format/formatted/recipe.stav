import "std/build" as build
import "laft/target" as target

## A fast compression library and tool.
package zstd {
  version = "1.5.6"
  summary = "Zstandard compression library and tools"
  license = [BSD-3-Clause, GPL-2.0-only]

  source main {
    url    = "https://github.com/facebook/zstd/releases/download/v#{self.version}/zstd-#{self.version}.tar.gz"
    sha256 = "sha256:8c29e06cf42aacc1eafc4077ae2ec6c6fcb96a626157e0593d5e82a34fd403c1"
  }

  patches = [./patches/0001-no-werror.patch]

  build_deps = [meson, ninja, pkgconf]
  link_deps  = [zlib, xz, lz4]

  build meson {
    options = match target.variant {
      dynamic => ["-Ddefault_library=shared"]
      static  => ["-Ddefault_library=static", "-Dbin_programs=true"]
    }
  }

  phases {
    subdir       = "build/meson"
    post_install = """
      install -Dm644 ../../LICENSE "$DESTDIR/usr/share/licenses/zstd/LICENSE"
      rm -f "$DESTDIR"/usr/bin/zstd-frugal
      """
  }

  subpackage libs {
    summary = "Zstandard shared library"
    files   = ["usr/lib/libzstd.so.*"]
  }

  smoke = "zstd --version | grep -q #{self.version}"
}
