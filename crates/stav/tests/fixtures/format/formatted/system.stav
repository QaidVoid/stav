# The machine configuration of a small workstation.
import "std/desktop" as desktop
import "std/services" as services

let admin_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGq7w0d6r1Yb6vXcT2pJmH3k4sLq2xNnR8Zf admin@laptop",
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKd9yP0aQ4u2wZt7m1cB5eVr3hJnL6sF0gXo admin@phone",
]

system {
  include "./hardware.stav"

  hostname      = "workbench"
  timezone      = "Europe/Oslo"
  locale        = "nb_NO.UTF-8"
  extra_locales = ["en_US.UTF-8"]

  packages = [editor, vcs, notes, finder:static, lister, shell, browser, compiler@19:static]

  alternatives.sh = small-sh

  users {
    mutable = false
    user ada {
      uid      = 1000
      groups   = [wheel, video, virt] # virt for virtual machines
      shell    = "/usr/bin/shell"
      ssh_keys = admin_keys
    }
    group media { members = [ada] }
  }

  # Desktop and services.
  include desktop.graphical(
    user = ada,
    compositor = tiling,
    fonts = [mono-font, cjk-font, emoji-font],
  )
  include services.gateway(port = 2222)

  service backup {
    kind  = oneshot
    exec  = ["/usr/bin/archiver", "backup", "--one-file-system", "/home"]
    after = [network]
  }

  for name in ["tty1", "tty2"] {
    console { ttys = [name] }
  }

  if enable_printing {
    service printd { exec = ["/usr/bin/printd", "-f"] }
  } else {
    packages = []
  }

  file "/etc/profile.d/editor.sh" {
    text = """
      export EDITOR=editor
      export VISUAL="$EDITOR"
      """
    mode = 0o644
  }

  file "/etc/term/term.ini" { source = ./files/term.ini }

  tunables {
    "mem.reclaim"    = 10
    "net.forwarding" = 1
  }

  kernel {
    modules   = ["virt-host", "pci-passthru"]
    blacklist = ["beeper"]
    options   = { sound_card = "power_save=1" }
  }
}
