--- TOML
levels = ["debug", "info", "warn"]

[limits]
debug = 1
info = 2
warn = 3

[tunables]
"mem.reclaim" = 10
"net.forwarding" = 1

[env]
LOG_LEVEL = "info"
"WITH SPACE" = "yes"

[kernel]
modules = ["virt-host", "pci-passthru"]

[kernel.params]
quiet = ""
--- YAML
limits:
  debug: 1
  info: 2
  warn: 3
levels:
  - debug
  - info
  - warn
tunables:
  mem.reclaim: 10
  net.forwarding: 1
env:
  LOG_LEVEL: info
  WITH SPACE: "yes"
kernel:
  modules:
    - virt-host
    - pci-passthru
  params:
    quiet: ""
