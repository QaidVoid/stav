---
source: crates/stav/tests/format.rs
expression: formatted
---
# /etc/laft/system.stav, written by hand without care for layout
import "std/services" as services
system {
  include "./hardware.stav"
  hostname = "lab"
  timezone = "UTC"
  locale   = "en_GB.UTF-8"

  packages = [htop, ripgrep:static, opendoas, prometheus-node-exporter, tmux, git, neovim, curl, jq]
  users {
    mutable = false
    user ops {
      uid      = 1001
      groups   = [wheel]
      ssh_keys = ["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM2n ops@desk"]
    }
  }
  include services.sshd(port = 22)
  service exporter {
    exec  = ["/usr/bin/node_exporter", "--web.listen-address=:9100"] # metrics
    user  = nobody
    after = [network]
  }
  service boot-complete { after = [sshd] }
  sysctl { "net.ipv4.ip_forward" = 1 }
  file "/etc/motd" {
    text = """
      Welcome to the lab.
        Be nice.
      """
  }
}
